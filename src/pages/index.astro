---
const a = Astro.url.searchParams.get('a') ?? '';
const b = Astro.url.searchParams.get('b') ?? '';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pelis en común · Letterboxd</title>
    <style>
      :root {
        --bg: #14181c;
        --panel: #1c2228;
        --line: #2c3440;
        --text: #e1e3e5;
        --muted: #9ab;
        --green: #00e054;
        --orange: #ff8000;
        --blue: #40bcf4;
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font: 15px/1.5 system-ui, -apple-system, 'Segoe UI', sans-serif;
        background: var(--bg);
        color: var(--text);
      }
      main { max-width: 960px; margin: 0 auto; padding: 32px 16px 64px; }
      h1 { margin: 0 0 4px; font-size: 1.8rem; letter-spacing: -0.02em; }
      .dots { display: inline-flex; gap: 4px; margin-right: 10px; vertical-align: middle; }
      .dots i { width: 14px; height: 14px; border-radius: 50%; display: block; }
      .sub { color: var(--muted); margin: 0 0 24px; }
      .tabs { display: flex; gap: 4px; margin-bottom: -1px; }
      .tabs button {
        background: none; border: 1px solid transparent; border-bottom: none; color: var(--muted);
        padding: 8px 14px; border-radius: 8px 8px 0 0; cursor: pointer; font: inherit;
      }
      .tabs button[aria-selected='true'] { background: var(--panel); border-color: var(--line); color: var(--text); }
      .view-tabs { margin-bottom: 12px; border-bottom: 1px solid var(--line); }
      .view-tabs button span { color: var(--muted); font-variant-numeric: tabular-nums; }
      .view-tabs button[aria-selected='true'] { border-bottom: 2px solid var(--green); }
      #view-note { margin: 0 0 12px; color: var(--muted); font-size: 0.9rem; }
      .rating-col[hidden] { display: none; }
      form {
        background: var(--panel); border: 1px solid var(--line); border-radius: 8px;
        padding: 16px; display: grid; gap: 12px; grid-template-columns: 1fr 1fr auto; align-items: end;
      }
      #warnings { margin: 16px 0 0; padding: 10px 14px; border: 1px solid #6b4e00; background: #2a2200; color: #ffd27a; border-radius: 8px; font-size: 0.9rem; }
      #warnings[hidden] { display: none; }
      #warnings ul { margin: 4px 0 0; padding-left: 18px; }
      label { display: grid; gap: 4px; font-size: 0.85rem; color: var(--muted); }
      input {
        font: inherit; color: var(--text); background: var(--bg); border: 1px solid var(--line);
        border-radius: 6px; padding: 8px 10px; width: 100%;
      }
      input[type='file'] { padding: 6px; }
      button.primary, a.btn {
        font: inherit; font-weight: 600; background: var(--green); color: #0b1a10; border: 0;
        border-radius: 6px; padding: 9px 16px; cursor: pointer; text-decoration: none; white-space: nowrap;
      }
      button.primary:disabled { opacity: 0.6; cursor: wait; }
      .hint { grid-column: 1 / -1; margin: 0; font-size: 0.85rem; color: var(--muted); }
      .hint a { color: var(--blue); }
      #status { margin: 20px 0 0; min-height: 1.5em; color: var(--muted); }
      #status.error { color: #ff6b6b; }
      #results[hidden] { display: none; }
      .stats { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin: 20px 0; }
      .stat { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 12px; }
      .stat b { display: block; font-size: 1.6rem; font-variant-numeric: tabular-nums; }
      .stat span { color: var(--muted); font-size: 0.8rem; overflow-wrap: anywhere; }
      .toolbar { display: flex; gap: 12px; align-items: center; margin-bottom: 12px; }
      .toolbar input { flex: 1; }
      .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; }
      table { width: 100%; border-collapse: collapse; }
      th, td { padding: 8px 12px; text-align: left; border-bottom: 1px solid var(--line); }
      th {
        position: sticky; top: 0; background: var(--panel); font-size: 0.8rem; text-transform: uppercase;
        letter-spacing: 0.05em; color: var(--muted); cursor: pointer; user-select: none; white-space: nowrap;
      }
      th[data-dir='asc']::after { content: ' ▲'; }
      th[data-dir='desc']::after { content: ' ▼'; }
      tbody tr:hover { background: #1f262d; }
      td a { color: var(--text); text-decoration: none; }
      td a:hover { color: var(--blue); }
      td.num { font-variant-numeric: tabular-nums; color: var(--muted); }
      td.stars { color: var(--green); white-space: nowrap; }
      .empty { padding: 24px; text-align: center; color: var(--muted); }
      @media (max-width: 640px) {
        form { grid-template-columns: 1fr; }
        .stats { grid-template-columns: 1fr 1fr; }
        .stats .stat:last-child { grid-column: 1 / -1; }
        .toolbar { flex-direction: column; align-items: stretch; }
      }
    </style>
  </head>
  <body>
    <main>
      <h1>
        <span class="dots"><i style="background:var(--orange)"></i><i style="background:var(--green)"></i><i style="background:var(--blue)"></i></span>
        Pelis en común
      </h1>
      <p class="sub">Compará lo que vieron dos personas en Letterboxd, encontrá qué pueden ver juntos y descargalo en Excel.</p>

      <form id="form-user">
        <label>Usuario A <input name="a" placeholder="frache04 o link al perfil" value={a} required /></label>
        <label>Usuario B <input name="b" placeholder="pedro_schiaff" value={b} required /></label>
        <button class="primary" type="submit">Comparar</button>
        <p class="hint">Lee los perfiles públicos de Letterboxd: pelis vistas y watchlist.</p>
      </form>

      <div id="warnings" hidden></div>
      <p id="status" role="status"></p>

      <section id="results" hidden>
        <div class="stats">
          <div class="stat"><b id="s-common">0</b><span>en común</span></div>
          <div class="stat"><b id="s-pct">0%</b><span>coincidencia</span></div>
          <div class="stat"><b id="s-a">0</b><span id="s-a-label">vistas A</span></div>
          <div class="stat"><b id="s-b">0</b><span id="s-b-label">vistas B</span></div>
          <div class="stat"><b id="s-wl">0</b><span id="s-wl-label">para ver juntos</span></div>
        </div>
        <div class="tabs view-tabs" role="tablist">
          <button role="tab" aria-selected="true" data-view="common">Vistas en común <span id="c-common"></span></button>
          <button role="tab" aria-selected="false" data-view="watchlist">🍿 Para ver juntos <span id="c-wl"></span></button>
        </div>
        <p id="view-note"></p>
        <div class="toolbar">
          <input id="filter" type="search" placeholder="Filtrar por título o año…" />
          <a class="btn" id="download" href="#">⬇ Descargar Excel</a>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th data-key="title">Título</th>
                <th data-key="year">Año</th>
                <th data-key="ratingA" id="th-a" class="rating-col">Rating A</th>
                <th data-key="ratingB" id="th-b" class="rating-col">Rating B</th>
              </tr>
            </thead>
            <tbody id="tbody"></tbody>
          </table>
        </div>
      </section>
    </main>

    <script>
      type Film = { title: string; year: number | null; url: string; ratingA: number | null; ratingB: number | null };
      type Result = { warnings: string[]; userA: string; userB: string; totalA: number; totalB: number; watchlistTotalA: number; watchlistTotalB: number; common: Film[]; watchlistCommon: Film[] };

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const status = $('status');
      let result: Result | null = null;
      let sortKey: keyof Film = 'title';
      let sortDir: 1 | -1 = 1;
      let view: 'common' | 'watchlist' = 'common';

      const stars = (r: number | null) => (r == null ? '—' : '★'.repeat(Math.floor(r)) + (r % 1 ? '½' : ''));
      const esc = (s: string) =>
        s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

      function setStatus(msg: string, error = false) {
        status.textContent = msg;
        status.className = error ? 'error' : '';
      }

      function render() {
        if (!result) return;
        const q = $<HTMLInputElement>('filter').value.trim().toLowerCase();
        const withRatings = view === 'common';
        document.querySelectorAll<HTMLElement>('.rating-col').forEach((th) => (th.hidden = !withRatings));
        $('view-note').textContent = withRatings
          ? `Pelis que vieron ${result.userA} y ${result.userB}.`
          : `Pelis que están en la watchlist de ${result.userA} y de ${result.userB}: las quieren ver los dos.`;
        const source = withRatings ? result.common : result.watchlistCommon;
        const rows = source
          .filter((f) => !q || f.title.toLowerCase().includes(q) || String(f.year ?? '').includes(q))
          .sort((x, y) => {
            const a = x[sortKey], b = y[sortKey];
            if (a == null && b == null) return 0;
            if (a == null) return 1;
            if (b == null) return -1;
            return (typeof a === 'string' ? a.localeCompare(b as string, 'es', { sensitivity: 'base' }) : (a as number) - (b as number)) * sortDir;
          });
        $('tbody').innerHTML = rows.length
          ? rows
              .map(
                (f) => `<tr>
                  <td><a href="${esc(f.url)}" target="_blank" rel="noopener">${esc(f.title)}</a></td>
                  <td class="num">${f.year ?? ''}</td>
                  ${withRatings ? `<td class="stars">${stars(f.ratingA)}</td><td class="stars">${stars(f.ratingB)}</td>` : ''}
                </tr>`,
              )
              .join('')
          : `<tr><td colspan="4" class="empty">${source.length ? 'Nada coincide con el filtro.' : withRatings ? 'No tienen pelis vistas en común 😢' : 'No hay pelis en la watchlist de los dos (o no se cargó la watchlist).'}</td></tr>`;
        document.querySelectorAll<HTMLElement>('th[data-key]').forEach((th) => {
          if (th.dataset.key === sortKey) th.dataset.dir = sortDir === 1 ? 'asc' : 'desc';
          else delete th.dataset.dir;
        });
      }

      function show(r: Result) {
        result = r;
        const min = Math.min(r.totalA, r.totalB) || 1;
        $('s-common').textContent = String(r.common.length);
        $('s-pct').textContent = `${Math.round((r.common.length / min) * 100)}%`;
        $('s-a').textContent = String(r.totalA);
        $('s-b').textContent = String(r.totalB);
        $('s-a-label').textContent = `vistas por ${r.userA}`;
        $('s-b-label').textContent = `vistas por ${r.userB}`;
        $('th-a').textContent = `★ ${r.userA}`;
        $('th-b').textContent = `★ ${r.userB}`;
        $('s-wl').textContent = String(r.watchlistCommon.length);
        $('c-common').textContent = `(${r.common.length})`;
        $('c-wl').textContent = `(${r.watchlistCommon.length})`;
        $('results').hidden = false;
        const warn = $('warnings');
        warn.hidden = !r.warnings.length;
        warn.innerHTML = r.warnings.length
          ? `⚠ Resultados incompletos:<ul>${r.warnings.map((w) => `<li>${esc(w)}</li>`).join('')}</ul>`
          : '';
        setStatus('');
        render();
      }

      async function run(form: HTMLFormElement, req: () => Promise<Response>) {
        const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
        btn.disabled = true;
        setStatus('Buscando pelis… (puede tardar unos segundos si vieron muchas)');
        try {
          const res = await req();
          const data = await res.json();
          if (!res.ok) throw new Error(data.error ?? `Error ${res.status}`);
          show(data);
        } catch (e) {
          $('results').hidden = true;
          $('warnings').hidden = true;
          setStatus((e as Error).message, true);
        } finally {
          btn.disabled = false;
        }
      }

      $<HTMLFormElement>('form-user').addEventListener('submit', (ev) => {
        ev.preventDefault();
        const fd = new FormData(ev.target as HTMLFormElement);
        const params = new URLSearchParams({ a: String(fd.get('a')), b: String(fd.get('b')) });
        history.replaceState(null, '', `?${params}`);
        run(ev.target as HTMLFormElement, () => fetch(`/api/common.json?${params}`));
      });

      $('filter').addEventListener('input', render);
      document.querySelectorAll<HTMLButtonElement>('[role=tab][data-view]').forEach((tab) =>
        tab.addEventListener('click', () => {
          document.querySelectorAll('[role=tab][data-view]').forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
          view = tab.dataset.view as typeof view;
          if (view === 'watchlist' && (sortKey === 'ratingA' || sortKey === 'ratingB')) { sortKey = 'title'; sortDir = 1; }
          render();
        }),
      );
      document.querySelectorAll<HTMLElement>('th[data-key]').forEach((th) =>
        th.addEventListener('click', () => {
          const key = th.dataset.key as keyof Film;
          sortDir = sortKey === key ? (sortDir === 1 ? -1 : 1) : key === 'title' ? 1 : -1;
          sortKey = key;
          render();
        }),
      );

      $('download').addEventListener('click', async (ev) => {
        ev.preventDefault();
        if (!result) return;
        const res = await fetch('/api/excel', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(result),
        });
        if (!res.ok) return setStatus('No se pudo generar el Excel', true);
        const blob = await res.blob();
        const name = /filename="([^"]+)"/.exec(res.headers.get('Content-Disposition') ?? '')?.[1] ?? 'pelis_en_comun.xlsx';
        const a = Object.assign(document.createElement('a'), { href: URL.createObjectURL(blob), download: name });
        a.click();
        URL.revokeObjectURL(a.href);
      });

      // Si la URL trae ?a=&b=, comparar directo (link compartible).
      const p = new URLSearchParams(location.search);
      if (p.get('a') && p.get('b')) $<HTMLFormElement>('form-user').requestSubmit();
    </script>
  </body>
</html>
