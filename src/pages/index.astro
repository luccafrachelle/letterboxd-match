---
const a = Astro.url.searchParams.get('a') ?? '';
const b = Astro.url.searchParams.get('b') ?? '';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pelis en común</title>
    <meta name="description" content="Las pelis que están en la watchlist de dos perfiles de Letterboxd." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 10'><circle cx='5' cy='5' r='5' fill='%23ff8000'/><circle cx='15' cy='5' r='5' fill='%2300e054'/><circle cx='25' cy='5' r='5' fill='%2340bcf4'/></svg>"
    />
    <style is:global>
      :root {
        --bg: #0d1014;
        --surface: #151a1f;
        --surface-2: #1b2127;
        --line: rgba(255, 255, 255, 0.07);
        --line-strong: rgba(255, 255, 255, 0.14);
        --text: #eef1f4;
        --muted: #8593a1;
        --faint: #55616d;
        --orange: #ff8000;
        --green: #00e054;
        --blue: #40bcf4;
        --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
        --spring: cubic-bezier(0.34, 1.45, 0.64, 1);
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; min-height: 100vh; background: var(--bg); color: var(--text);
        font: 15px/1.55 Inter, system-ui, -apple-system, 'Segoe UI', sans-serif; overflow-x: hidden;
      }
      .glow {
        position: fixed; inset: -20vmax; z-index: -1; pointer-events: none;
        background:
          radial-gradient(32vmax 32vmax at 12% 8%, rgba(255, 128, 0, 0.1), transparent 60%),
          radial-gradient(32vmax 32vmax at 88% 6%, rgba(64, 188, 244, 0.1), transparent 60%),
          radial-gradient(40vmax 40vmax at 50% 105%, rgba(0, 224, 84, 0.06), transparent 60%);
        animation: drift 24s ease-in-out infinite alternate;
      }
      @keyframes drift { to { transform: translate3d(3vmax, 2vmax, 0) rotate(3deg); } }
      .wrap { max-width: 1180px; margin: 0 auto; padding: 0 20px; }

      .topbar { display: flex; align-items: center; justify-content: space-between; height: 64px; }
      .brand { display: flex; align-items: center; gap: 10px; font-weight: 600; letter-spacing: -0.01em; color: var(--text); text-decoration: none; }
      .dots { display: inline-flex; gap: 4px; }
      .dots i { width: 11px; height: 11px; border-radius: 50%; display: block; }
      .dots i:nth-child(1) { background: var(--orange); }
      .dots i:nth-child(2) { background: var(--green); }
      .dots i:nth-child(3) { background: var(--blue); }
      .loading .dots i { animation: bounce 0.9s ease-in-out infinite; }
      .loading .dots i:nth-child(2) { animation-delay: 0.15s; }
      .loading .dots i:nth-child(3) { animation-delay: 0.3s; }
      @keyframes bounce { 50% { transform: translateY(-6px); } }
      .topbar nav a { color: var(--muted); text-decoration: none; font-size: 0.88rem; }
      .topbar nav a:hover { color: var(--text); }

      .hero { text-align: center; padding: 9vh 0 28px; transition: padding 0.6s var(--ease); }
      .has-results .hero { padding: 16px 0 20px; }
      h1 {
        margin: 0; font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; line-height: 0.95;
        font-size: clamp(3rem, 8vw, 5.4rem); letter-spacing: -0.015em; transition: font-size 0.6s var(--ease);
      }
      .has-results h1 { font-size: clamp(2.2rem, 5vw, 3rem); }
      h1 em {
        font-style: italic; background: linear-gradient(90deg, var(--orange), var(--green) 55%, var(--blue));
        -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: 0.06em;
      }
      .sub { color: var(--muted); margin: 16px auto 0; max-width: 470px; font-size: 1.05rem; }
      .has-results .sub { display: none; }

      form {
        max-width: 760px; margin: 32px auto 0; padding: 8px; display: flex; align-items: center; gap: 6px;
        background: var(--surface); border: 1px solid var(--line-strong); border-radius: 18px;
        box-shadow: 0 20px 60px -30px rgba(0, 0, 0, 0.8);
      }
      .has-results form { margin-top: 20px; }
      .field { flex: 1; position: relative; display: flex; align-items: center; min-width: 0; }
      .field .pin { position: absolute; left: 14px; width: 9px; height: 9px; border-radius: 50%; }
      #field-a .pin { background: var(--orange); }
      #field-b .pin { background: var(--blue); }
      input {
        font: inherit; font-size: 1rem; color: var(--text); background: transparent; width: 100%;
        border: 1px solid transparent; border-radius: 12px; padding: 12px 12px 12px 32px; transition: background 0.2s, border-color 0.2s;
      }
      input::placeholder { color: var(--faint); }
      input:hover { background: rgba(255, 255, 255, 0.03); }
      input:focus { outline: none; background: rgba(0, 0, 0, 0.25); border-color: var(--line-strong); }
      .swap {
        flex: none; width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--line-strong); background: var(--surface-2);
        color: var(--muted); cursor: pointer; font-size: 0.95rem; transition: transform 0.4s var(--ease), color 0.2s;
      }
      .swap:hover { color: var(--text); transform: rotate(180deg); }
      button.primary {
        flex: none; font: inherit; font-weight: 700; background: var(--green); color: #04150a; border: 0; border-radius: 12px;
        padding: 0 24px; height: 46px; cursor: pointer; transition: transform 0.15s, box-shadow 0.2s, filter 0.2s;
      }
      button.primary:hover { transform: translateY(-1px); box-shadow: 0 10px 28px -10px rgba(0, 224, 84, 0.7); }
      button.primary:disabled { filter: saturate(0.4) brightness(0.8); cursor: progress; transform: none; box-shadow: none; }

      #status { margin: 18px auto 0; max-width: 760px; min-height: 1.5em; color: var(--muted); text-align: center; }
      #status.error { color: #ffb4b4; background: rgba(255, 80, 80, 0.08); border: 1px solid rgba(255, 80, 80, 0.25); border-radius: 12px; padding: 10px 14px; animation: shake 0.4s; }
      @keyframes shake { 25% { transform: translateX(-5px); } 75% { transform: translateX(5px); } }

      #skeleton { display: grid; gap: 14px; margin-top: 8px; }
      #skeleton[hidden] { display: none; }
      .sk { border-radius: 16px; background: linear-gradient(90deg, rgba(255,255,255,0.03) 25%, rgba(255,255,255,0.07) 50%, rgba(255,255,255,0.03) 75%); background-size: 200% 100%; animation: shimmer 1.3s linear infinite; }
      .sk-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 16px; }
      .sk-grid .sk { aspect-ratio: 2 / 3; border-radius: 8px; }
      @keyframes shimmer { to { background-position: -200% 0; } }

      #results[hidden] { display: none; }
      .reveal { animation: rise 0.7s var(--ease) both; }
      @keyframes rise { from { opacity: 0; transform: translateY(16px); } }

      /* Versus con fotos de perfil */
      .versus {
        position: relative; overflow: hidden; border-radius: 22px; border: 1px solid var(--line);
        background: var(--surface); padding: 34px 24px 28px; margin-top: 8px;
        display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px;
      }
      .versus .amb { position: absolute; top: -30%; width: 55%; height: 160%; background-size: cover; background-position: center; filter: blur(60px) saturate(1.4); opacity: 0.28; pointer-events: none; }
      .versus .amb.a { left: -10%; }
      .versus .amb.b { right: -10%; }
      .versus::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent, rgba(13,16,20,0.55)); pointer-events: none; }
      .who { position: relative; z-index: 1; }
      .who.a { text-align: right; }
      .who h2 { margin: 0; font: 400 clamp(1.5rem, 3vw, 2.1rem)/1.1 'Instrument Serif', serif; overflow-wrap: anywhere; }
      .who h2 a { color: inherit; text-decoration: none; }
      .who h2 a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
      .who p { margin: 6px 0 0; color: var(--muted); font-size: 0.9rem; }
      .who p b { color: var(--text); font-weight: 600; font-variant-numeric: tabular-nums; }

      .meet { position: relative; z-index: 1; width: 300px; height: 170px; }
      .meet .ph {
        position: absolute; top: 15px; width: 140px; height: 140px; border-radius: 50%; overflow: hidden;
        background: var(--surface-2); display: grid; place-items: center;
        font: 400 3.2rem 'Instrument Serif', serif; color: var(--text); transition: transform 1.1s var(--spring);
      }
      .meet .ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .meet .ph.a { left: 0; box-shadow: 0 0 0 3px var(--orange), 0 18px 40px -12px rgba(255, 128, 0, 0.5); transform: translateX(-90px) scale(0.85); }
      .meet .ph.b { right: 0; z-index: 1; box-shadow: 0 0 0 3px var(--blue), 0 18px 40px -12px rgba(64, 188, 244, 0.5); transform: translateX(90px) scale(0.85); }
      .meet.go .ph.a { transform: translateX(var(--shift)) scale(1); }
      .meet.go .ph.b { transform: translateX(calc(var(--shift) * -1)) scale(1); }
      .meet .badge {
        position: absolute; z-index: 2; left: 50%; top: 50%; transform: translate(-50%, -50%) scale(0);
        min-width: 78px; height: 78px; padding: 0 10px; border-radius: 99px; display: grid; place-items: center; text-align: center;
        background: var(--bg); border: 2px solid var(--green); box-shadow: 0 0 0 6px rgba(0, 224, 84, 0.12), 0 10px 30px -8px rgba(0,0,0,0.8);
        transition: transform 0.6s var(--spring) 0.75s;
      }
      .meet.go .badge { transform: translate(-50%, -50%) scale(1); }
      .meet .badge b { display: block; font: 400 2rem/1 'Instrument Serif', serif; color: var(--green); }
      .meet .badge span { display: block; font-size: 0.56rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-top: 2px; }
      .meet .badge::before { content: ''; position: absolute; inset: -2px; border-radius: inherit; border: 2px solid var(--green); opacity: 0; }
      .meet.go .badge::before { animation: ping 2.4s ease-out 1.4s infinite; }
      @keyframes ping { 0% { transform: scale(1); opacity: 0.6; } 80%, 100% { transform: scale(1.5); opacity: 0; } }

      #warnings { margin-top: 12px; padding: 10px 14px; border-radius: 12px; font-size: 0.86rem; color: #ffd98a; background: rgba(255, 196, 0, 0.06); border: 1px solid rgba(255, 196, 0, 0.22); }
      #warnings[hidden] { display: none; }

      /* Barra de controles */
      .controls { position: sticky; top: 0; z-index: 5; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 24px; padding: 10px 0; background: linear-gradient(var(--bg) 70%, transparent); }
      .search { position: relative; flex: 1; min-width: 160px; }
      .search svg { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--faint); }
      .search input { padding-left: 36px; background: var(--surface); border-color: var(--line); height: 44px; }
      select {
        font: inherit; font-size: 0.9rem; color: var(--text); height: 44px; padding: 0 34px 0 12px; border-radius: 12px; cursor: pointer;
        background: var(--surface) url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6'><path d='M1 1l4 4 4-4' stroke='%238593a1' fill='none' stroke-width='1.5'/></svg>") no-repeat right 12px center;
        border: 1px solid var(--line); appearance: none;
      }
      .seg { display: flex; padding: 4px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); }
      .seg button { width: 36px; height: 34px; border: 0; border-radius: 8px; background: none; color: var(--faint); cursor: pointer; display: grid; place-items: center; transition: color 0.2s, background 0.2s; }
      .seg button[aria-pressed='true'] { background: var(--surface-2); color: var(--text); }
      .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; font: inherit; font-weight: 600; font-size: 0.9rem; border-radius: 12px; padding: 0 16px; height: 44px; cursor: pointer; transition: transform 0.15s, box-shadow 0.2s, background 0.2s, border-color 0.2s; }
      .btn:disabled { opacity: 0.6; cursor: progress; }
      .btn-ghost { color: var(--text); background: var(--surface); border: 1px solid var(--line-strong); }
      .btn-ghost:hover { border-color: var(--green); background: rgba(0, 224, 84, 0.07); }
      .btn-dl { color: #04150a; background: var(--green); border: 0; }
      .btn-dl:hover { transform: translateY(-1px); box-shadow: 0 10px 28px -10px rgba(0, 224, 84, 0.7); }
      .dice { transition: transform 0.6s var(--spring); }
      .rolling .dice { transform: rotate(360deg); }
      #out { margin-top: 8px; }

      /* Grilla de posters */
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 24px 16px; }
      .film { display: block; min-width: 0; color: inherit; text-decoration: none; animation: cardin 0.55s var(--ease) both; scroll-margin: 120px; }
      @keyframes cardin { from { opacity: 0; transform: translateY(14px) scale(0.97); } }
      .poster {
        position: relative; aspect-ratio: 2 / 3; border-radius: 8px; overflow: hidden; padding: 12px;
        display: flex; flex-direction: column; justify-content: flex-end;
        box-shadow: inset 0 0 0 1px rgba(255,255,255,0.1), 0 10px 24px -14px rgba(0,0,0,0.9);
        transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
      }
      .poster::before { content: ''; position: absolute; inset: 0; background: radial-gradient(120% 70% at 20% 0%, rgba(255,255,255,0.18), transparent 55%), linear-gradient(180deg, transparent 45%, rgba(0,0,0,0.6)); }
      .poster .t { position: relative; font: 400 1.3rem/1.05 'Instrument Serif', serif; color: #fff; text-wrap: balance; overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
      .poster img.pst { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; opacity: 0; transition: opacity 0.5s ease; }
      .poster img.pst.ok { opacity: 1; }
      .poster::after { content: ''; position: absolute; inset: 0; z-index: 2; border-radius: inherit; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.12); pointer-events: none; }
      .poster .go { position: absolute; inset: 0; z-index: 3; display: grid; place-items: center; font-size: 0.8rem; font-weight: 600; color: #fff; background: rgba(0,0,0,0.5); opacity: 0; transition: opacity 0.25s; }
      .film:hover .poster { transform: translateY(-5px); box-shadow: inset 0 0 0 1px rgba(255,255,255,0.18), 0 22px 40px -18px rgba(0,0,0,0.95); }
      .film:hover .go { opacity: 1; }
      .film .cap { margin-top: 9px; }
      .film .cap b { display: block; font-weight: 600; font-size: 0.9rem; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .film .cap span { color: var(--muted); font-size: 0.8rem; }
      /* Elegida al azar */
      .film.flash .poster { box-shadow: 0 0 0 3px var(--text); }
      .film.picked .poster { box-shadow: 0 0 0 3px var(--green), 0 0 40px 4px rgba(0, 224, 84, 0.35); animation: picked 0.9s var(--spring); }
      .film.picked .cap b { color: var(--green); }
      @keyframes picked { 0% { transform: scale(0.92); } 60% { transform: scale(1.06); } 100% { transform: scale(1); } }
      .grid.choosing .film:not(.picked) { opacity: 0.35; transition: opacity 0.4s; }

      /* Vista lista */
      .list { border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: var(--surface); }
      .list a.row { display: grid; grid-template-columns: 40px 1fr auto; gap: 14px; align-items: center; padding: 10px 16px; color: var(--text); text-decoration: none; animation: rowin 0.45s ease both; }
      .list a.row + a.row { border-top: 1px solid var(--line); }
      .list a.row:hover { background: rgba(255,255,255,0.03); }
      .list a.row:hover .tt { color: var(--green); }
      @keyframes rowin { from { opacity: 0; transform: translateX(-8px); } }
      .list .thumb { position: relative; width: 40px; height: 60px; border-radius: 4px; overflow: hidden; }
      .list .thumb img.pst { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.4s; }
      .list .thumb img.pst.ok { opacity: 1; }
      .list .tt { font-weight: 500; transition: color 0.15s; }
      .list .yr { color: var(--muted); font-variant-numeric: tabular-nums; font-size: 0.9rem; }
      .list a.row.picked { background: rgba(0, 224, 84, 0.08); }
      .empty { padding: 48px 16px; text-align: center; color: var(--muted); grid-column: 1 / -1; }
      .empty b { display: block; font: 400 2rem 'Instrument Serif', serif; color: var(--text); margin-bottom: 4px; }

      footer { margin: 56px 0 36px; text-align: center; color: var(--faint); font-size: 0.82rem; }
      footer a { color: var(--muted); }

      @media (max-width: 860px) {
        .versus { grid-template-columns: 1fr; text-align: center; padding: 26px 16px; }
        .who.a, .who.b { text-align: center; }
        .meet { margin: 0 auto; }
      }
      @media (max-width: 620px) {
        .wrap { padding: 0 14px; }
        .hero { padding-top: 5vh; }
        form { flex-direction: column; align-items: stretch; padding: 10px; border-radius: 16px; }
        .swap { align-self: center; transform: rotate(90deg); }
        .swap:hover { transform: rotate(270deg); }
        button.primary { width: 100%; }
        .meet { transform: scale(0.8); margin: -12px auto; }
        .controls { position: static; }
        .search { width: 100%; flex: none; }
        select { flex: 1; }
        .btn { flex: 1; }
        .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 12px; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation: none !important; transition: none !important; }
      }
    </style>
  </head>
  <body>
    <div class="glow"></div>
    <div class="wrap">
      <div class="topbar">
        <a class="brand" href="/"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>Pelis en común</a>
        <nav><a href="https://github.com/luccafrachelle/letterboxd-match" target="_blank" rel="noopener">GitHub</a></nav>
      </div>

      <section class="hero">
        <h1>Pelis en <em>común</em></h1>
        <p class="sub">Entre dos watchlists de Letterboxd.</p>
        <form id="form-user">
          <label class="field" id="field-a"><span class="pin"></span><input name="a" aria-label="Usuario 1" placeholder="Usuario 1" value={a} required autocomplete="off" autocapitalize="off" spellcheck="false" /></label>
          <button type="button" class="swap" id="swap" title="Intercambiar" aria-label="Intercambiar usuarios">⇄</button>
          <label class="field" id="field-b"><span class="pin"></span><input name="b" aria-label="Usuario 2" placeholder="Usuario 2" value={b} required autocomplete="off" autocapitalize="off" spellcheck="false" /></label>
          <button class="primary" type="submit">Comparar</button>
        </form>
        <p id="status" role="status"></p>
      </section>

      <div id="skeleton" hidden aria-hidden="true">
        <div class="sk" style="height:220px"></div>
        <div class="sk-grid"><div class="sk"></div><div class="sk"></div><div class="sk"></div><div class="sk"></div><div class="sk"></div><div class="sk"></div></div>
      </div>

      <section id="results" hidden>
        <div class="versus reveal">
          <div class="amb a" id="amb-a"></div>
          <div class="amb b" id="amb-b"></div>
          <div class="who a">
            <h2><a id="name-a" target="_blank" rel="noopener"></a></h2>
            <p><span id="handle-a"></span><b id="wl-a"></b> en watchlist</p>
          </div>
          <div class="meet" id="meet">
            <div class="ph a" id="ph-a"></div>
            <div class="ph b" id="ph-b"></div>
            <div class="badge"><div><b id="badge-n">0</b><span>en común</span></div></div>
          </div>
          <div class="who b">
            <h2><a id="name-b" target="_blank" rel="noopener"></a></h2>
            <p><span id="handle-b"></span><b id="wl-b"></b> en watchlist</p>
          </div>
        </div>

        <div id="warnings" hidden></div>

        <div class="controls">
          <label class="search">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
            <input id="filter" type="search" placeholder="Buscar título o año" aria-label="Buscar" />
          </label>
          <select id="sort" aria-label="Ordenar">
            <option value="title:1">Título A–Z</option>
            <option value="year:-1">Más nuevas</option>
            <option value="year:1">Más viejas</option>
          </select>
          <div class="seg" role="group" aria-label="Vista">
            <button type="button" data-layout="grid" aria-pressed="true" title="Grilla"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="7.5" height="7.5" rx="1.5"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.5"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.5"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.5"/></svg></button>
            <button type="button" data-layout="list" aria-pressed="false" title="Lista"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
          </div>
          <button class="btn btn-ghost" id="random" type="button" title="Elegir una al azar"><svg class="dice" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg><span>Al azar</span></button>
          <button class="btn btn-dl" id="download" type="button" title="Descargar Excel">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"/></svg>
            Excel
          </button>
        </div>
        <div id="out"></div>
      </section>

      <footer>
        Datos de <a href="https://letterboxd.com" target="_blank" rel="noopener">Letterboxd</a> · Posters de Letterboxd y Wikipedia
      </footer>
    </div>

    <script>
      type Film = { title: string; year: number | null; url: string; poster?: string | null };
      type Result = {
        warnings: string[]; userA: string; userB: string; avatarA?: string | null; avatarB?: string | null;
        nameA?: string | null; nameB?: string | null;
        watchlistTotalA: number; watchlistTotalB: number; watchlistCommon: Film[];
      };
      type SortKey = 'title' | 'year';

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const status = $('status');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let result: Result | null = null;
      let sortKey: SortKey = 'title';
      let sortDir: 1 | -1 = 1;
      let layout: 'grid' | 'list' = 'grid';

      const esc = (s: string) =>
        s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

      // Poster de respaldo generado (si la imagen real no carga).
      const PALETTE = [
        ['#c2412d', '#2a0d0a'], ['#1f7a8c', '#071c26'], ['#d39b2a', '#3a1f05'], ['#6c4bc4', '#150c33'],
        ['#c74b7c', '#2e0b1d'], ['#e0672f', '#33100a'], ['#3c6e9e', '#0b1626'], ['#5f8a3a', '#122108'],
        ['#2aa198', '#062521'], ['#9e2b3a', '#24060c'], ['#8a6f5a', '#1e1510'], ['#b84fb0', '#260a28'],
      ];
      function hash(s: string) {
        let h = 0;
        for (const c of s) h = (h * 31 + c.codePointAt(0)!) >>> 0;
        return h;
      }
      const posterBg = (t: string) => {
        const h = hash(t);
        const [light, dark] = PALETTE[h % PALETTE.length];
        return `background: linear-gradient(${140 + (h % 50)}deg, ${light}, ${dark} 78%)`;
      };
      const safePoster = (u: string | null | undefined): u is string =>
        !!u && /^https:\/\/(a\.ltrbxd\.com\/resized\/film-poster|upload\.wikimedia\.org)\//.test(u);
      // Si la imagen no carga, se saca y queda el afiche generado de fondo.
      const posterImg = (f: Film) =>
        safePoster(f.poster) ? `<img class="pst" src="${esc(f.poster)}" alt="" decoding="async" referrerpolicy="no-referrer" />` : '';
      document.addEventListener('load', (e) => {
        const t = e.target as HTMLElement;
        if (t instanceof HTMLImageElement && t.classList.contains('pst')) t.classList.add('ok');
      }, true);
      document.addEventListener('error', (e) => {
        const img = e.target as HTMLElement;
        if (!(img instanceof HTMLImageElement)) return;
        if (img.classList.contains('pst')) img.remove();
        else if (img.classList.contains('av-img')) img.replaceWith(img.dataset.i ?? '');
      }, true);

      const avatar = (url: string | null | undefined, name: string) =>
        url
          ? `<img class="av-img" src="${esc(url)}" alt="" data-i="${esc(name.slice(0, 1).toUpperCase())}" referrerpolicy="no-referrer" />`
          : esc(name.slice(0, 1).toUpperCase());

      function setStatus(msg: string, error = false) {
        status.textContent = msg;
        status.className = error ? 'error' : '';
      }

      function countUp(el: HTMLElement, to: number, delay = 0) {
        if (reduced) return void (el.textContent = String(to));
        el.textContent = '0';
        const dur = 900 + Math.min(to, 300) * 2;
        setTimeout(() => {
          const start = performance.now();
          const tick = (now: number) => {
            const t = Math.min(1, (now - start) / dur);
            el.textContent = String(Math.round(to * (1 - Math.pow(1 - t, 3))));
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }, delay);
      }

      function sortedRows(): Film[] {
        if (!result) return [];
        const q = $<HTMLInputElement>('filter').value.trim().toLowerCase();
        return result.watchlistCommon
          .filter((f) => !q || f.title.toLowerCase().includes(q) || String(f.year ?? '').includes(q))
          .sort((x, y) => {
            const a = x[sortKey], b = y[sortKey];
            if (a == null && b == null) return 0;
            if (a == null) return 1;
            if (b == null) return -1;
            const c = typeof a === 'string' ? a.localeCompare(b as string, 'es', { sensitivity: 'base' }) : (a as number) - (b as number);
            return c * sortDir || x.title.localeCompare(y.title, 'es');
          });
      }

      function render() {
        if (!result) return;
        const r = result;
        const rows = sortedRows();
        $<HTMLButtonElement>('random').disabled = rows.length < 1;
        if (!rows.length) {
          $('out').innerHTML = r.watchlistCommon.length
            ? '<div class="empty"><b>Sin resultados</b></div>'
            : '<div class="empty"><b>Ninguna en común</b></div>';
          return;
        }
        const delay = (i: number) => `animation-delay:${Math.min(i, 24) * 28}ms`;
        if (layout === 'grid') {
          $('out').innerHTML = `<div class="grid">${rows
            .map(
              (f, i) => `<a class="film" href="${esc(f.url)}" target="_blank" rel="noopener" style="${delay(i)}">
                <div class="poster" style="${posterBg(f.title)}">
                  <span class="t">${esc(f.title)}</span>
                  ${posterImg(f)}
                  <span class="go">Abrir en Letterboxd</span>
                </div>
                <div class="cap"><b title="${esc(f.title)}">${esc(f.title)}</b><span>${f.year ?? ''}</span></div>
              </a>`,
            )
            .join('')}</div>`;
        } else {
          $('out').innerHTML = `<div class="list">${rows
            .map(
              (f, i) => `<a class="row" href="${esc(f.url)}" target="_blank" rel="noopener" style="${delay(i)}">
                <span class="thumb" style="${posterBg(f.title)}">${posterImg(f)}</span>
                <span class="tt">${esc(f.title)}</span>
                <span class="yr">${f.year ?? ''}</span>
              </a>`,
            )
            .join('')}</div>`;
        }
      }

      // Ruleta: recorre las pelis y frena en una al azar.
      async function pickRandom() {
        const items = [...$('out').querySelectorAll<HTMLElement>('.film, a.row')];
        if (!items.length) return;
        const btn = $<HTMLButtonElement>('random');
        btn.disabled = true;
        btn.classList.add('rolling');
        items.forEach((el) => el.classList.remove('picked', 'flash'));
        const grid = $('out').querySelector('.grid');
        grid?.classList.remove('choosing');
        const winner = Math.floor(Math.random() * items.length);
        if (!reduced) {
          const steps = Math.min(18, items.length * 2 + 4);
          let prev: HTMLElement | null = null;
          for (let s = 0; s < steps; s++) {
            const idx = s === steps - 1 ? winner : Math.floor(Math.random() * items.length);
            prev?.classList.remove('flash');
            prev = items[idx];
            prev.classList.add('flash');
            await new Promise((r) => setTimeout(r, 60 + s * s * 1.6));
          }
          prev?.classList.remove('flash');
        }
        items[winner].classList.add('picked');
        grid?.classList.add('choosing');
        items[winner].scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
        btn.classList.remove('rolling');
        btn.disabled = false;
      }

      function show(r: Result) {
        result = r;
        document.body.classList.add('has-results');
        for (const [k, user, url, wl, display] of [
          ['a', r.userA, r.avatarA, r.watchlistTotalA, r.nameA],
          ['b', r.userB, r.avatarB, r.watchlistTotalB, r.nameB],
        ] as const) {
          const name = $<HTMLAnchorElement>(`name-${k}`);
          const differs = !!display && display.toLowerCase() !== user.toLowerCase();
          name.textContent = differs ? display! : `@${user}`;
          $(`handle-${k}`).textContent = differs ? `@${user} · ` : '';
          name.href = `https://letterboxd.com/${encodeURIComponent(user)}/watchlist/`;
          $(`wl-${k}`).textContent = String(wl);
          $(`ph-${k}`).innerHTML = avatar(url, display || user);
          $(`amb-${k}`).style.backgroundImage = url ? `url("${url}")` : 'none';
          $(`amb-${k}`).style.backgroundColor = url ? '' : k === 'a' ? 'var(--orange)' : 'var(--blue)';
        }
        // Cuanto más en común (sobre la watchlist más corta), más se superponen las fotos.
        const pct = r.watchlistCommon.length / (Math.min(r.watchlistTotalA, r.watchlistTotalB) || 1);
        const meet = $('meet');
        meet.style.setProperty('--shift', `${Math.round(8 + 42 * Math.min(1, pct / 0.5))}px`);
        meet.classList.remove('go');
        void meet.offsetWidth;
        requestAnimationFrame(() => meet.classList.add('go'));
        countUp($('badge-n'), r.watchlistCommon.length, 800);

        const warn = $('warnings');
        warn.hidden = !r.warnings.length;
        warn.textContent = r.warnings.length ? 'Resultado parcial: Letterboxd no dejó leer toda la watchlist.' : '';
        warn.title = r.warnings.join('\n');

        const res = $('results');
        res.hidden = false;
        res.querySelectorAll<HTMLElement>('.reveal').forEach((el) => {
          el.style.animationName = 'none';
          void el.offsetWidth;
          el.style.animationName = '';
        });
        setStatus('');
        render();
      }

      async function run(a: string, b: string) {
        const btn = $<HTMLFormElement>('form-user').querySelector<HTMLButtonElement>('button[type=submit]')!;
        btn.disabled = true;
        btn.textContent = 'Comparando…';
        document.body.classList.add('loading');
        $('results').hidden = true;
        $('skeleton').hidden = false;
        setStatus('');
        try {
          const res = await fetch(`/api/common.json?${new URLSearchParams({ a, b })}`);
          const data = await res.json();
          if (!res.ok) throw new Error(data.error ?? `Error ${res.status}`);
          $('skeleton').hidden = true;
          show(data);
        } catch (e) {
          $('skeleton').hidden = true;
          setStatus((e as Error).message, true);
        } finally {
          document.body.classList.remove('loading');
          btn.disabled = false;
          btn.textContent = 'Comparar';
        }
      }

      const form = $<HTMLFormElement>('form-user');
      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const fd = new FormData(form);
        const a = String(fd.get('a')).trim();
        const b = String(fd.get('b')).trim();
        history.replaceState(null, '', `?${new URLSearchParams({ a, b })}`);
        run(a, b);
      });
      $('swap').addEventListener('click', () => {
        const ia = form.elements.namedItem('a') as HTMLInputElement;
        const ib = form.elements.namedItem('b') as HTMLInputElement;
        [ia.value, ib.value] = [ib.value, ia.value];
      });
      $('filter').addEventListener('input', render);
      $<HTMLSelectElement>('sort').addEventListener('change', (e) => {
        const [k, d] = (e.target as HTMLSelectElement).value.split(':');
        sortKey = k as SortKey;
        sortDir = Number(d) as 1 | -1;
        render();
      });
      document.querySelectorAll<HTMLButtonElement>('[data-layout]').forEach((b) =>
        b.addEventListener('click', () => {
          layout = b.dataset.layout as typeof layout;
          document.querySelectorAll('[data-layout]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          render();
        }),
      );
      $('random').addEventListener('click', pickRandom);

      $('download').addEventListener('click', async () => {
        if (!result) return;
        const btn = $<HTMLButtonElement>('download');
        btn.disabled = true;
        try {
          const res = await fetch('/api/excel', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(result) });
          if (!res.ok) return setStatus('No se pudo generar el Excel', true);
          const blob = await res.blob();
          const name = /filename="([^"]+)"/.exec(res.headers.get('Content-Disposition') ?? '')?.[1] ?? 'para_ver_juntos.xlsx';
          const link = Object.assign(document.createElement('a'), { href: URL.createObjectURL(blob), download: name });
          link.click();
          setTimeout(() => URL.revokeObjectURL(link.href), 1000);
        } finally {
          btn.disabled = false;
        }
      });

      const p = new URLSearchParams(location.search);
      if (p.get('a') && p.get('b')) form.requestSubmit();
    </script>
  </body>
</html>
